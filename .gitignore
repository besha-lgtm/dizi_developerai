# ==============================================
# SECRETS — NEVER PUSH THESE
# ==============================================
backend/.env
.env
.env.*
*.env

# ==============================================
# PYTHON — Backend
# ==============================================

# Virtual environment
backend/.venv/
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# Local runtime data / session storage (created automatically on startup)
backend/sessions.json
backend/daily_usage.json
backend/*.json

# ==============================================
# NODE / ANGULAR — Frontend
# ==============================================

# Dependencies (huge folder, auto-installed)
node_modules/

# Angular build output
dist/

# Angular cache
.angular/

# ==============================================
# OS / SYSTEM FILES
# ==============================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==============================================
# IDE / EDITOR FILES
# ==============================================

# VS Code
.vscode/
*.code-workspace

# JetBrains (PyCharm, WebStorm)
.idea/
*.iml

# Vim / Emacs
*.swp
*.swo
*~

# ==============================================
# LOGS
# ==============================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

